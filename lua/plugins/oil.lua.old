return {
	"stevearc/oil.nvim",
	dependencies = { "nvim-tree/nvim-web-devicons" },
	keys = {
		{ "-", "<cmd>Oil --float<cr>", desc = "Open Oil" },
	},
	opts = {
		float = {
			padding = 2,
			max_width = 0.8,
			max_height = 0.8,
			border = "rounded",
		},
		keymaps = {
			["<CR>"] = "actions.select",
			["K"] = "actions.preview", -- Standard preview key
			["<C-p>"] = "actions.preview", -- Secondary preview
			["q"] = "actions.close",
			["<BS>"] = "actions.parent", -- Backspace to go UP
			["H"] = "actions.parent", -- H to go UP (folder up)
			["L"] = "actions.select", -- L to go DOWN (enter folder)
		},
	},
}
